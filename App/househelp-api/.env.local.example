# Local Docker Compose env template.
# Copy to .env.local and fill in secrets. .env.local is gitignored.
#
# Hostnames point at compose service names (postgres, redis), NOT localhost.
# This file is consumed by the `backend` service in docker-compose.yml.

# ----- Server -----
PORT=8080
ENV=development
APP_ENV=development

# ----- Database (compose service: postgres) -----
DATABASE_URL=postgres://househelp:localdev123@postgres:5432/househelp_db?sslmode=disable
TEST_DATABASE_URL=postgres://househelp:localdev123@postgres:5432/househelp_test?sslmode=disable
MIGRATIONS_PATH=/app/migrations

# Postgres bootstrap creds — consumed by the postgres container.
POSTGRES_USER=househelp
POSTGRES_PASSWORD=localdev123
POSTGRES_DB=househelp_db

# Pool tuning (smaller than prod since local box is constrained)
DB_POOL_MIN_CONNS=5
DB_POOL_MAX_CONNS=20
DB_POOL_MAX_CONN_LIFETIME_MINUTES=20
DB_POOL_MAX_CONN_IDLE_MINUTES=5
DB_POOL_HEALTHCHECK_SECONDS=60
DB_BOUND_MAX_INFLIGHT=200
DB_BOUND_QUEUE_WAIT_MS=75

# ----- Redis (compose service: redis) -----
REDIS_URL=redis://redis:6379

# ----- JWT -----
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output-for-local-dev-only
JWT_SECRET_ID=local-dev
JWT_PREVIOUS_SECRETS=
JWT_EXPIRY_HOURS=24

# CRM JWTs
CRM_JWT_SECRET=replace-with-distinct-local-crm-secret
CRM_JWT_PREVIOUS_SECRETS=
CRM_REFRESH_COOKIE_DOMAIN=localhost
CRM_ALLOWED_ORIGINS=http://localhost:3000
CRM_DATABASE_READ_URL=

# ----- CORS -----
# Include your Expo dev server LAN URL if testing from a device.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ----- Firebase -----
# Place service-account JSON in App/househelp-api/secrets/ on the host.
# It is mounted read-only into the container at /app/secrets/.
FIREBASE_CREDENTIALS_JSON=/app/secrets/firebase-adminsdk.json

# ----- Google Maps -----
GOOGLE_MAPS_API_KEY=

# ----- OpenRouter (Zop AI assistant) -----
OPENROUTER_API_KEY=

# ----- Cashfree Payouts (optional in dev — empty disables) -----
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=
CASHFREE_ENV=sandbox

# ----- Cashfree PG (optional in dev — empty disables) -----
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_WEBHOOK_SECRET=

# Public callback URL for Cashfree webhooks. Local dev: use an ngrok https URL.
PUBLIC_BASE_URL=

# ----- App-side URL (used by CRM healthmetrics) -----
APP_API_URL=http://backend:8080

# ----- Webhook domain allowlist -----
ALLOWED_WEBHOOK_DOMAINS=

# ----- Debug toggles (DO NOT enable in prod) -----
ENABLE_PPROF=false
ENABLE_STUB_ENUMERATOR=false
ALLOW_PROD_SIM=false
LOADTEST_JWT_HOURS=24

# ----- Message Central VerifyNow OTP gateway -----
# Message Central VerifyNow OTP gateway. CUSTOMER_ID + AUTH_TOKEN are
# required in production; OTP_DEV_MODE=true short-circuits all network
# calls and accepts the hardcoded OTP "999999" so local/integration
# testers can complete the phone flow without a real SMS.
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com
OTP_DEV_MODE=true

# ----- Dev seed-state harness (internal/booking/dev_seed.go) -----
# Phase 1 test harness for fast-forwarding bookings across states
# without walking the full lifecycle. Triple-gated: (1) build tag
# `dev` — the harness file is absent from prod binaries (the
# BUILD_TAGS docker arg is set to 'dev' only in docker-compose.yml's
# backend build); (2) runtime APP_ENV=development required; (3) the
# X-Dev-Seed-Key header on each request must match DEV_SEED_KEY.
#
# DEV_SEED_KEY: shared secret. Any non-empty value works for local dev.
# MUST stay unset in any prod env. If empty, the handler returns 503 —
# fails closed.
DEV_SEED_KEY=dev-seed-local

# Phone for the auto-upserted test pro account. Pro app signs in with
# this phone + OTP "999999" (OTP_DEV_MODE bypass above). Pick numbers
# outside any real user range.
DEV_TEST_HELPER_PHONE=+919999000002
DEV_TEST_CUSTOMER_PHONE=+919999000001
