{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zopmop.com/schemas/sdui_page_config.json",
  "title": "SduiPageConfig",
  "type": "object",
  "required": ["page_id", "version", "min_client_version", "sections"],
  "additionalProperties": false,
  "properties": {
    "page_id":            { "type": "string", "minLength": 1, "maxLength": 64 },
    "version":            { "type": "string", "minLength": 1, "maxLength": 32 },
    "min_client_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "experiment_id":      { "type": "string" },
    "schema_version":     { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": { "$ref": "#/definitions/section_or_include" }
    }
  },
  "definitions": {
    "section_or_include": {
      "oneOf": [
        { "$ref": "#/definitions/include" },
        { "$ref": "#/definitions/section" }
      ]
    },
    "include": {
      "type": "object",
      "required": ["$include"],
      "additionalProperties": false,
      "properties": {
        "$include": { "type": "string", "minLength": 1 }
      }
    },
    "ref": {
      "type": "object",
      "required": ["$ref"],
      "additionalProperties": false,
      "properties": {
        "$ref":      { "type": "string", "minLength": 1 },
        "$default":  {},
        "$required": { "type": "boolean" }
      }
    },
    "ref_or_string":  { "oneOf": [ { "type": "string" },  { "$ref": "#/definitions/ref" } ] },
    "ref_or_number":  { "oneOf": [ { "type": "number" },  { "$ref": "#/definitions/ref" } ] },
    "ref_or_bool":    { "oneOf": [ { "type": "boolean" }, { "$ref": "#/definitions/ref" } ] },
    "ref_or_any":     {},
    "color_token": {
      "type": "string",
      "enum": [
        "brand-primary", "brand-secondary",
        "surface", "surface-alt",
        "text-primary", "text-muted",
        "border"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height":            { "type": "number" },
        "width":             { "oneOf": [ { "type": "number" }, { "type": "string", "pattern": "^\\d+%$" } ] },
        "flex":              { "type": "number" },
        "flexDirection":     { "type": "string", "enum": ["row", "column"] },
        "alignItems":        { "type": "string", "enum": ["flex-start", "center", "flex-end", "stretch"] },
        "justifyContent":    { "type": "string", "enum": ["flex-start", "center", "flex-end", "space-between"] },
        "gap":               { "type": "number" },
        "zIndex":            { "type": "number" },
        "marginTop":         { "type": "number" },
        "marginBottom":      { "type": "number" },
        "marginHorizontal":  { "type": "number" },
        "paddingHorizontal": { "type": "number" },
        "paddingVertical":   { "type": "number" },
        "borderRadius":      { "type": "number" },
        "overflow":          { "type": "string", "enum": ["hidden", "visible"] }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg":     { "$ref": "#/definitions/color_token" },
        "fg":     { "$ref": "#/definitions/color_token" },
        "radius": { "type": "string", "enum": ["sm", "md", "lg", "full"] }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_client_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "user_segment":       { "type": "string", "enum": ["all", "premium", "new_user", "returning"] },
        "percentage":         { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "action": {
      "type": "object",
      "required": ["trigger", "type"],
      "properties": {
        "trigger": { "type": "string", "enum": ["tap", "long_press", "auto"] },
        "type":    { "type": "string", "enum": ["navigate", "bottom_sheet", "toast", "api_call", "deep_link", "load_more"] }
      },
      "allOf": [
        {
          "if":   { "properties": { "type": { "const": "navigate" } } },
          "then": { "required": ["screen"], "properties": { "screen": { "type": "string" }, "params": { "type": "object" } } }
        },
        {
          "if":   { "properties": { "type": { "const": "bottom_sheet" } } },
          "then": { "required": ["sheet_id"], "properties": { "sheet_id": { "type": "string" }, "props": { "type": "object" } } }
        },
        {
          "if":   { "properties": { "type": { "const": "toast" } } },
          "then": { "required": ["message"], "properties": { "message": { "type": "string" }, "variant": { "type": "string", "enum": ["info", "success", "error"] } } }
        },
        {
          "if":   { "properties": { "type": { "const": "api_call" } } },
          "then": { "required": ["endpoint", "method"], "properties": { "endpoint": { "type": "string" }, "method": { "type": "string", "enum": ["POST", "DELETE"] }, "body": { "type": "object" } } }
        },
        {
          "if":   { "properties": { "type": { "const": "deep_link" } } },
          "then": { "required": ["url"], "properties": { "url": { "type": "string" } } }
        },
        {
          "if":   { "properties": { "type": { "const": "load_more" } } },
          "then": { "required": ["section_id", "cursor", "endpoint"], "properties": { "section_id": { "type": "string" }, "cursor": { "type": "string" }, "endpoint": { "type": "string" } } }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "type", "data"],
      "properties": {
        "id":       { "type": "string", "minLength": 1, "maxLength": 64 },
        "type":     { "type": "string", "enum": ["hero_carousel", "live_pill", "usuals_row", "service_grid", "footer", "greeting_hero", "header_promo"] },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "hydration": { "type": "string", "enum": ["eager", "lazy"] },
        "lazy_endpoint": { "type": "string" },
        "layout":   { "$ref": "#/definitions/layout" },
        "style":    { "$ref": "#/definitions/style" },
        "actions":  { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "visible":  { "oneOf": [ { "type": "boolean" }, { "$ref": "#/definitions/ref" } ] },
        "rollout":  { "$ref": "#/definitions/rollout" },
        "data":     { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
