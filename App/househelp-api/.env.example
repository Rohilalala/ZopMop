# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://househelp:localdev123@localhost:5432/househelp_db
# For PgBouncer, point DATABASE_URL to port 6432 instead of 5432.
# Example: postgres://househelp:localdev123@localhost:6432/househelp_db

# PostgreSQL pool tuning (application side)
DB_POOL_MIN_CONNS=20
DB_POOL_MAX_CONNS=80
DB_POOL_MAX_CONN_LIFETIME_MINUTES=20
DB_POOL_MAX_CONN_IDLE_MINUTES=5
DB_POOL_HEALTHCHECK_SECONDS=60
# Request-level DB-bound concurrency guardrail
DB_BOUND_MAX_INFLIGHT=600
DB_BOUND_QUEUE_WAIT_MS=75

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# Use a 64+ character high-entropy secret.
# Example: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
# Key ID for the active signing key (placed in JWT "kid" header)
JWT_SECRET_ID=active-2026-04
# Optional rotation keys in format: key_id:secret,key_id:secret
# JWT_PREVIOUS_SECRETS=active-2026-03:old-secret-1,active-2026-02:old-secret-2
JWT_PREVIOUS_SECRETS=
JWT_EXPIRY_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase (service account for verifying phone auth tokens)
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# Place the file in secrets/ (never commit it)
FIREBASE_CREDENTIALS_JSON=./secrets/your-firebase-adminsdk.json

# Google Maps (Distance Matrix + Directions APIs must be enabled on this key)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenRouter — powers the Zop AI assistant (Gemma cleaner + Llama chat).
OPENROUTER_API_KEY=your-openrouter-api-key
