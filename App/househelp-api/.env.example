# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://househelp:localdev123@localhost:5432/househelp_db
# For PgBouncer, point DATABASE_URL to port 6432 instead of 5432.
# Example: postgres://househelp:localdev123@localhost:6432/househelp_db

# PostgreSQL pool tuning (application side)
DB_POOL_MIN_CONNS=20
DB_POOL_MAX_CONNS=80
DB_POOL_MAX_CONN_LIFETIME_MINUTES=20
DB_POOL_MAX_CONN_IDLE_MINUTES=5
DB_POOL_HEALTHCHECK_SECONDS=60
# Request-level DB-bound concurrency guardrail
DB_BOUND_MAX_INFLIGHT=600
DB_BOUND_QUEUE_WAIT_MS=75

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# Use a 64+ character high-entropy secret.
# Example: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
# Key ID for the active signing key (placed in JWT "kid" header)
JWT_SECRET_ID=active-2026-04
# Optional rotation keys in format: key_id:secret,key_id:secret
# JWT_PREVIOUS_SECRETS=active-2026-03:old-secret-1,active-2026-02:old-secret-2
JWT_PREVIOUS_SECRETS=
JWT_EXPIRY_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase (service account for verifying phone auth tokens)
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# Place the file in secrets/ (never commit it)
FIREBASE_CREDENTIALS_JSON=./secrets/your-firebase-adminsdk.json

# Google Maps (Distance Matrix + Directions APIs must be enabled on this key)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenRouter — powers the Zop AI assistant (Gemma cleaner + Llama chat).
OPENROUTER_API_KEY=your-openrouter-api-key

# Sentry error tracking (optional — Init no-ops when SENTRY_DSN is empty).
# Get DSN from Sentry → Project Settings → Client Keys (DSN).
SENTRY_DSN=
# Environment tag for events. Defaults to APP_ENV/ENV, then "production".
SENTRY_ENVIRONMENT=
# Performance monitoring sample rate (0.0 = off, 1.0 = sample every request).
SENTRY_TRACES_SAMPLE_RATE=0
# Release identifier. Pass the git SHA at deploy time so issues group
# correctly. Railway exposes RAILWAY_GIT_COMMIT_SHA which you can wire here.
SENTRY_RELEASE=

# Cashfree Payouts (separate product from Cashfree PG below). Used for VPA
# validation today (POST /payments/validate-vpa) and helper disbursement later.
# Leave empty in local dev; the route returns 503 when unset.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional override; defaults to payout-gamma.cashfree.com (sandbox) or
# payout-api.cashfree.com (production) based on CASHFREE_ENV.
CASHFREE_BASE_URL=
CASHFREE_ENV=sandbox

# Cashfree Payment Gateway (collection — order/checkout/webhook).
# Get keys from Cashfree Dashboard → Developers → API Keys.
# Leave all four empty to disable PG and fall back to the manual gateway.
# CASHFREE_PG_ENV must be either "sandbox" or "production".
# Webhook secret defaults to CASHFREE_PG_SECRET_KEY when unset; override only
# when the merchant dashboard rotates the webhook signing key separately.
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_WEBHOOK_SECRET=

# Public base URL of the API as reachable from the public internet.
# Used to build the Cashfree webhook callback URL.
# Examples:
#   local dev (ngrok):  https://abc123.ngrok-free.app
#   production:         https://api.zopmop.com
# Required when CASHFREE_PG_APP_ID is set. Must use https://.
PUBLIC_BASE_URL=
