# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://househelp:localdev123@localhost:5432/househelp_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRY_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase (service account for verifying phone auth tokens)
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# Place the file in secrets/ (never commit it)
FIREBASE_CREDENTIALS_JSON=./secrets/your-firebase-adminsdk.json
