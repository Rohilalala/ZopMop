# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Backend API base URL (use your machine's LAN IP for local dev, HTTPS URL for production)
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8080/api/v1

# Google Maps SDK key — embedded in native binaries only (NOT in the JS bundle).
# Restrict in GCP: Android package name + SHA-1 / iOS bundle ID.
GOOGLE_MAPS_API_KEY=

# Razorpay test/public key for client-side checkout UI.
# Example: EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY is intentionally absent.
# Address search and reverse-geocoding use expo-location's on-device geocoder.
# No API key is required, and nothing is compiled into the JavaScript bundle.
