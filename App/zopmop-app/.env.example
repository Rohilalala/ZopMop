# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Backend API base URL (use your machine's LAN IP for local dev, HTTPS URL for production)
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8080/api/v1

# Google Maps SDK key — embedded in native binaries only (NOT in the JS bundle).
# Restrict in GCP: Android package name + SHA-1 / iOS bundle ID.
GOOGLE_MAPS_API_KEY=

# Cashfree Payment Gateway — publishable App ID for the React Native SDK.
# Safe to ship in the JS bundle (publishable, not secret). The matching
# secret key lives ONLY on the backend (CASHFREE_PG_SECRET_KEY in
# househelp-api/.env). Get it from Cashfree Dashboard → Developers → API Keys.
# Example: EXPO_PUBLIC_CASHFREE_PG_APP_ID=TEST1100000abcdef…
EXPO_PUBLIC_CASHFREE_PG_APP_ID=

# Cashfree environment — must match the App ID above. "sandbox" for test
# keys, "production" for live keys. Defaults to "sandbox" when unset.
EXPO_PUBLIC_CASHFREE_ENV=sandbox

# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY is intentionally absent.
# Address search and reverse-geocoding use expo-location's on-device geocoder.
# No API key is required, and nothing is compiled into the JavaScript bundle.
