EXPO_PUBLIC_API_URL=https://zopmop-production.up.railway.app/api/v1
# Cashfree gateway environment. MUST be 'production' for release builds — a
# missing/incorrect value routes REAL payments to the test gateway (resolveEnvironment
# in src/hooks/useCashfreePayment.ts throws in a release build if this isn't 'production').
EXPO_PUBLIC_CASHFREE_ENV=production
