# Copy to .env and fill in. The dev server runs on port 5174 (set in
# vite.config.ts) and proxies /admin/* requests to VITE_CRM_API_URL — so the
# SPA never speaks to a different origin in dev.

# Where the CRM API lives. In dev, point at your local crm-api binary.
VITE_CRM_API_URL=http://localhost:8090

# Google Maps JS API key — enable: Maps JavaScript API, Maps Static API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
